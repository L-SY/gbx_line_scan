# 注意: 这是模板文件，请使用 install_service.sh 安装
# 安装命令: sudo ./install_service.sh

[Unit]
Description=GBX Line Scan Startup Script
After=network.target

[Service]
Type=oneshot
# 路径会在安装时自动替换
ExecStart=__SCRIPT_PATH__/startup.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
