[Desktop Entry]
Type=Application
Name=Workflow GUI
Comment=启动Workflow GUI应用程序
Exec=bash -c 'SCRIPT="$(find "$HOME" -path "*/auto_start/startup.sh" -type f 2>/dev/null | head -1)"; [ -n "$SCRIPT" ] && "$SCRIPT"'
Icon=utilities-terminal
Terminal=false
Categories=Utility;Application;
StartupNotify=false
X-GNOME-Autostart-enabled=true
