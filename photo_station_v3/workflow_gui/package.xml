<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>workflow_gui</name>
  <version>1.0.0</version>
  <description>Complete workflow GUI for photo station v3 with motor control, light control, and dual camera display</description>
  <maintainer email="yang@example.com">yang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Launch file dependencies -->
  <exec_depend>predictor_module</exec_depend>
  <exec_depend>hk_light_controller</exec_depend>
  <exec_depend>hk_line_camera</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
